{
  "name": "dacubeking-smp-site",
  "compatibility_date": "2026-11-01",
  // Cloudflare serves ./public directly. src/index.js only runs for /api/*.
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "play.dacubeking.com", "custom_domain": true }]
}
